{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Console",
  "version": "0.1.0",
  "identifier": "com.ajapaukese.ps5-mode-launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "C:\\Users\\Altered\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\node\\bin\\node.exe node_modules\\vite\\bin\\vite.js --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "C:\\Users\\Altered\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\node\\bin\\node.exe node_modules\\vite\\bin\\vite.js build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Console",
        "width": 1920,
        "height": 1080,
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "backgroundColor": "#05060a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}

